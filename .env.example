# Application Environment Configuration
NODE_ENV=development
PORT=3000

# Security & CORS
# Comma-separated list of allowed origins (e.g. http://localhost:3000,http://localhost:5173)
CORS_ORIGIN=http://localhost:3000

# Express Trust Proxy Configuration
# Options: "false" (default), "true", hop count (e.g. "1"), or IP/subnet (e.g. "loopback, linklocal, uniquelocal")
TRUST_PROXY=false

# Rate Limiting Configuration
# Window in milliseconds (default: 900000 ms = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per IP per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# HTTP Request Body Size Limits
# Maximum payload size for JSON and urlencoded bodies (default: 10kb)
BODY_SIZE_LIMIT=10kb

